{
  "opencollection": "1.0.0",
  "info": {
    "name": "Snipcart REST AbandonedCarts Customers API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.snipcart.com/api/customers",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Zero-based offset for pagination"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "email",
                "value": "",
                "type": "query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "to",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the list of all your existing customers with optional filtering."
        },
        {
          "info": {
            "name": "Get customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.snipcart.com/api/customers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique customer identifier"
              }
            ]
          },
          "docs": "Retrieves information about a specific customer."
        },
        {
          "info": {
            "name": "List customer orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.snipcart.com/api/customers/:id/orders",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique customer identifier"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Zero-based offset for pagination"
              }
            ]
          },
          "docs": "Returns a list of orders associated with a particular customer."
        }
      ]
    }
  ],
  "bundled": true
}